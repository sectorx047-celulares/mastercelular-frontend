.panel-notas, .recursos-box { margin-top: 1.25rem; background: var(--color-fondo); border: 1px solid var(--color-borde); border-radius: var(--radio); padding: 1rem 1.25rem; }
.panel-notas h3, .recursos-box h3 { font-size: 1.05rem; }
.nota-form { display: grid; gap: 0.5rem; grid-template-columns: 1fr; margin-bottom: 0.75rem; }
