.lista-notas { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.75rem; }
.lista-notas__vacia { color: var(--color-texto-suave); font-size: 0.95rem; }
.nota {
  border: 1px solid var(--color-borde);
  border-left: 4px solid var(--color-principal);
  border-radius: 0.5rem;
  padding: 0.75rem 1rem;
