/* Estado de la nota */
.formulario-estado { min-height: 1.2em; }
.formulario--estrecho { max-width: 520px; margin: 0 auto; }

/* ==========================================================
   Panel de acceso a Google Drive (alumnos FULL)
   ========================================================== */
.drive-acceso {
