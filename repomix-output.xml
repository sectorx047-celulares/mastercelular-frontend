}
.nota__cabecera {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 0.35rem;
}
.nota p { margin: 0; white-space: pre-wrap; }

.material {
  display: flex;
  justify-content: space-between;
