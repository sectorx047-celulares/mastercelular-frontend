.reproductor-barra__estado--bloqueado { color: #b42318; }
.capa-bloqueo, .capa-vacia { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.75rem; padding: 1.25rem; text-align: center; color: #fff; background: rgba(11, 15, 25, 0.92); }
