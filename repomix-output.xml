.wa-flotante { position: fixed; right: 1rem; bottom: 1rem; z-index: 20; background: #25d366; color: #fff; padding: 0.7rem 1rem; border-radius: 999px; text-decoration: none; font-weight: 700; box-shadow: 0 4px 14px rgba(0,0,0,.2); }
.toast { position: fixed; left: 50%; bottom: 5rem; transform: translateX(-50%); background: #1f2933; color: #fff; padding: 0.75rem 1.1rem; border-radius: 0.75rem; max-width: 90vw; z-index: 30; box-shadow: 0 6px 18px rgba(0,0,0,.25); }
.aviso-pais { background: #fff8e1; border-bottom: 1px solid #f5d37a; padding: 0.75rem 1rem; display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; justify-content: center; }
