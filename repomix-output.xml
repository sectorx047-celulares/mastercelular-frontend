<file path="cliente/src/assets/css/estilos.css">
/* ==========================================================
   Plantilla de landing page para cursos
   Cambia solo los colores en :root para adaptar la marca.
   ========================================================== */

:root {
  --color-principal: #1e6fd9;
  --color-principal-oscuro: #1656a8;
  --color-acento: #f5a623;
  --color-texto: #1f2933;
  --color-texto-suave: #52606d;
  --color-fondo: #ffffff;
  --color-fondo-alterno: #f3f6fb;
  --color-borde: #d9e2ec;
  --radio: 0.75rem;
}

/* Base: box-sizing global según el manual */
*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  font-size: 100%;
}

body {
  margin: 0;
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color: var(--color-texto);
  background: var(--color-fondo);
  line-height: 1.6;
}

img {
  max-width: 100%;
  height: auto;
  display: block;
}

h1, h2, h3 {
  line-height: 1.2;
  margin: 0 0 1rem;
}

h1 { font-size: 2.25rem; }
h2 { font-size: 1.75rem; }
h3 { font-size: 1.2rem; }

p { margin: 0 0 1rem; }

/* Contenedor centrado */
.contenedor {
  width: min(100% - 2rem, 1080px);
  margin-inline: auto;
}

/* Encabezado */
.encabezado {
  background: var(--color-fondo);
  border-bottom: 1px solid var(--color-borde);
  position: sticky;
  top: 0;
  z-index: 10;
}

.encabezado-interior {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-block: 0.75rem;
}

.encabezado-marca {
  font-weight: 700;
  color: var(--color-principal);
}

/* Botones */
.boton {
  display: inline-block;
  text-decoration: none;
  font-weight: 700;
  border-radius: var(--radio);
  padding: 0.85rem 1.5rem;
  transition: background-color 0.2s ease;
}

.boton--principal {
  background: var(--color-principal);
  color: #fff;
}

.boton--principal:hover,
.boton--principal:focus-visible {
  background: var(--color-principal-oscuro);
}

.boton--pequeno {
  padding: 0.5rem 1rem;
  background: var(--color-principal);
  color: #fff;
  font-size: 0.9rem;
}

/* Hero */
.hero {
  padding-block: 3rem;
}

.hero-grid {
  display: grid;
  gap: 2rem;
  align-items: center;
}

.etiqueta {
  display: inline-block;
  font-size: 0.85rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--color-principal);
}

.hero-subtitulo {
  font-size: 1.1rem;
  color: var(--color-texto-suave);
}

.precio {
  font-size: 1.1rem;
}

.precio--grande {
  font-size: 2.25rem;
  font-weight: 700;
}

.nota {
  font-size: 0.9rem;
  color: var(--color-texto-suave);
  margin-top: 0.75rem;
}

.hero-imagen {
  margin: 0;
}

/* Secciones */
.seccion {
  padding-block: 3rem;
}

.seccion--alterna {
  background: var(--color-fondo-alterno);
}

.seccion--oferta {
  background: var(--color-principal);
  color: #fff;
}

.seccion--oferta .precio--grande,
.seccion--oferta h2 {
  color: #fff;
}

.seccion--cierre {
  text-align: center;
  background: var(--color-fondo-alterno);
}

/* Tarjetas y rejillas */
.tarjeta {
  background: var(--color-fondo);
  border: 1px solid var(--color-borde);
  border-radius: var(--radio);
  padding: 1.25rem;
}

.lista-tarjetas {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 1rem;
}

.rejilla {
  display: grid;
  gap: 1rem;
}

/* Lista con marca de verificación */
.lista-check {
  list-style: none;
  padding: 0;
  margin: 0 0 1.5rem;
}

.lista-check li {
  padding-left: 1.75rem;
  position: relative;
  margin-bottom: 0.6rem;
}

.lista-check li::before {
  content: "\2713";
  position: absolute;
  left: 0;
  font-weight: 700;
  color: var(--color-acento);
}

/* Video responsivo */
.video-contenedor {
  position: relative;
  aspect-ratio: 16 / 9;
  width: 100%;
}

.video-contenedor iframe {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border: 0;
  border-radius: var(--radio);
}

/* Preguntas frecuentes */
.faq {
  border: 1px solid var(--color-borde);
  border-radius: var(--radio);
  padding: 1rem 1.25rem;
  margin-bottom: 0.75rem;
}

.faq summary {
  cursor: pointer;
  font-weight: 700;
}

.faq p {
  margin-top: 0.75rem;
}

/* Pie */
.pie {
  border-top: 1px solid var(--color-borde);
  padding-block: 2rem;
  font-size: 0.9rem;
  color: var(--color-texto-suave);
}

/* Responsivo: escritorio */
@media (min-width: 768px) {
  .hero-grid {
    grid-template-columns: 1.1fr 0.9fr;
  }

  .lista-tarjetas,
  .rejilla {
    grid-template-columns: repeat(3, 1fr);
  }

  h1 { font-size: 3rem; }
  h2 { font-size: 2.1rem; }
}

/* Accesibilidad: respetar preferencia de movimiento reducido */
@media (prefers-reduced-motion: reduce) {
  * {
    transition: none !important;
  }
}

/* ==========================================================
   Componentes añadidos: registro, reproductor y temario
   ========================================================== */
.oculto { display: none !important; }

.contenedor--estrecho { max-width: 640px; }

.seccion-sub {
  color: var(--color-texto-suave);
  margin-bottom: 1.5rem;
}

.boton--grande { padding: 1rem 1.75rem; font-size: 1.05rem; }
.boton--bloque { display: block; width: 100%; text-align: center; border: 0; cursor: pointer; font-size: 1rem; }
.boton--blanco { background: #fff; color: var(--color-principal-oscuro); }

/* Formularios */
.formulario {
  background: var(--color-fondo);
  border: 1px solid var(--color-borde);
  border-radius: var(--radio);
  padding: 1.5rem;
  display: grid;
  gap: 1rem;
}

.campo { display: grid; gap: 0.35rem; }
.campo label { font-weight: 700; }
.campo input {
  font: inherit;
  padding: 0.75rem 0.9rem;
  border: 1px solid var(--color-borde);
  border-radius: 0.5rem;
  width: 100%;
}
.campo input:focus-visible { outline: 3px solid var(--color-principal); outline-offset: 2px; }
.campo small { color: var(--color-texto-suave); font-size: 0.85rem; }

.formulario-estado { margin: 0; min-height: 1.2em; font-weight: 700; color: var(--color-principal-oscuro); }
.formulario-estado--error { color: #b42318; }

/* Reproductor */
.plataforma {
  display: grid;
  gap: 1.5rem;
}

.reproductor { min-width: 0; }

.reproductor-barra {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 0.5rem;
  font-weight: 700;
  margin-bottom: 0.75rem;
}

.etiqueta-estado {
  font-size: 0.85rem;
  color: var(--color-principal-oscuro);
}

.reproductor-marco {
  position: relative;
  aspect-ratio: 16 / 9;
  background: #0b0f19;
  border-radius: var(--radio);
  overflow: hidden;
}

.reproductor-marco iframe {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border: 0;
}

.reproductor-bloqueado,
.reproductor-vacio {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  padding: 1.5rem;
  text-align: center;
  color: #fff;
  background: rgba(11, 15, 25, 0.9);
}

/* Temario */
.temario h2 { font-size: 1.3rem; }
.temario-progreso { color: var(--color-texto-suave); font-size: 0.9rem; }

.acordeon {
  border: 1px solid var(--color-borde);
  border-radius: 0.5rem;
  margin-bottom: 0.75rem;
  background: var(--color-fondo);
}
.acordeon summary {
  cursor: pointer;
  padding: 0.75rem 1rem;
  font-weight: 700;
}

.item-clase {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 0.5rem;
  width: 100%;
  text-align: left;
  font: inherit;
  padding: 0.6rem 1rem;
  background: none;
  border: 0;
  border-top: 1px solid var(--color-borde);
  cursor: pointer;
}
.item-clase:hover,
.item-clase:focus-visible { background: var(--color-fondo-alterno); }
.item-clase--activa { background: var(--color-fondo-alterno); font-weight: 700; }
.item-clase__tag { font-size: 0.8rem; color: var(--color-principal-oscuro); font-weight: 700; }

@media (min-width: 960px) {
  .plataforma { grid-template-columns: 1.6fr 1fr; align-items: start; }
}

/* ==========================================================
   Estudio: botones, apuntes, materiales y comparación
   ========================================================== */
.boton--secundario {
  background: var(--color-fondo);
  color: var(--color-principal-oscuro);
  border: 2px solid var(--color-principal);
  cursor: pointer;
  font: inherit;
}
