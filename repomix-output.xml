}

@media (min-width: 768px) {
  .estudio-grid { grid-template-columns: 1fr 1fr; }
  .rejilla--cuatro { grid-template-columns: repeat(2, 1fr); }
}

/* Caja de la carpeta completa en Drive */
.carpeta-box {
  background: var(--color-fondo-alterno);
  border: 1px solid var(--color-principal);
  border-radius: var(--radio);
