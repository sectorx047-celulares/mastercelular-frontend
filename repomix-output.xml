<file path=".github/workflows/deploy-backend.yml">
name: Deploy Backend to Cloudflare Workers

on:
  push:
    branches: [main]
    paths:
      - 'mastercelular-api/**'
      - '.github/workflows/deploy-backend.yml'
  workflow_dispatch:

permissions:
  contents: write  # Needed for version bump + tag push
  id-token: write

env:
  CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
  CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}

jobs:
  quality-gate:
    name: Quality Gate (Lint, TypeCheck, Tests, Audit)
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: ./mastercelular-api

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0  # Needed for version bump

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
          cache-dependency-path: mastercelular-api/package-lock.json

      - name: Install dependencies
        run: npm ci

      - name: Run ESLint
        run: npx eslint src --ext .ts --max-warnings 0
        continue-on-error: false

      - name: TypeScript type check
        run: npx tsc --noEmit

      - name: Run tests with coverage
        run: npm test -- --coverage

      - name: Security audit (fail on high/critical)
        run: npm audit --audit-level=high

  deploy:
    name: Deploy Worker to Cloudflare
    runs-on: ubuntu-latest
    needs: quality-gate
    defaults:
      run:
        working-directory: ./mastercelular-api

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
          cache-dependency-path: mastercelular-api/package-lock.json

      - name: Install dependencies
        run: npm ci

      - name: Build TypeScript
        run: npm run build

      - name: Deploy to Cloudflare Workers
        uses: cloudflare/wrangler-action@v3
        with:
          apiToken: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          accountId: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
          command: deploy
          workingDirectory: ./mastercelular-api
          environment: production

      - name: Verify deployment
        run: |
          echo "✅ Backend deployed successfully!"
          echo "Health: https://mastercelular-api.<your-subdomain>.workers.dev/health"

      - name: Bump version & Create changelog entry
        if: success()
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          npm version patch --no-git-tag-version
          VERSION=$(node -p "require('./package.json').version")
          echo "## [$VERSION] - $(date +%Y-%m-%d)" >> CHANGELOG.md
          echo "" >> CHANGELOG.md
          echo "### Fixed" >> CHANGELOG.md
          echo "- Automated patch release" >> CHANGELOG.md
          echo "" >> CHANGELOG.md
          git add package.json CHANGELOG.md
          git commit -m "chore: release v$VERSION [skip ci]"
          git tag "v$VERSION"
          git push origin main --tags
</file>

<file path=".github/workflows/deploy-frontend.yml">
name: Deploy Frontend to Cloudflare Pages

on:
  push:
    branches: [main]
    paths:
      - 'cliente/**'
      - '.github/workflows/deploy-frontend.yml'
  workflow_dispatch:

permissions:
  contents: read
  deployments: write

env:
  CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
  CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
  PROJECT_NAME: mastercelular-frontend

jobs:
  quality-gate:
    name: Quality Gate (Build Verification)
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: ./cliente

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
          cache-dependency-path: cliente/package-lock.json

      - name: Install dependencies (if package.json exists)
        run: |
          if [ -f package.json ]; then
            npm ci
          else
            echo "No package.json found, skipping npm install"
          fi

      - name: Build frontend
        run: node build.js

      - name: Verify dist/ exists and has content
        run: |
          ls -la dist/
          test -f dist/index.html || (echo "❌ index.html not found in dist/" && exit 1)
          echo "✅ Build verification passed"

      - name: Check for broken HTML (basic validation)
        run: |
          if command -v npx >/dev/null 2>&1; then
            npx html-validate dist/**/*.html --formatter stylish || echo "⚠️ html-validate not installed, skipping"
          fi

  deploy:
    name: Build & Deploy to Cloudflare Pages
    runs-on: ubuntu-latest
    needs: quality-gate
    defaults:
      run:
        working-directory: ./cliente

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
          cache-dependency-path: cliente/package-lock.json

      - name: Install dependencies (if package.json exists)
        run: |
          if [ -f package.json ]; then
            npm ci
          else
            echo "No package.json found, skipping npm install"
          fi

      - name: Build frontend
        run: node build.js

      - name: Verify dist/ exists
        run: ls -la dist/

      - name: Deploy to Cloudflare Pages
        uses: cloudflare/pages-action@v1
        with:
          apiToken: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          accountId: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
          projectName: ${{ env.PROJECT_NAME }}
          directory: ./cliente/dist
          gitHubToken: ${{ secrets.GITHUB_TOKEN }}
          branch: main
          wranglerVersion: '3'
</file>

