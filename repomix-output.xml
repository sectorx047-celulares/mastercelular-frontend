// mastercelular-api/src/routes/progress.ts
// POST /api/progress — Marcar/desmarcar clase como vista
import { Hono } from 'hono';
import { zValidator } from '@hono/zod-validator';
import { z } from 'zod';

import type { Env, JWTPayload } from '../types';
import { requireAuth } from '../middleware/auth';

const app = new Hono<{ Bindings: Env; Variables: { user: JWTPayload } }>();

const progressSchema = z.object({
  course_id: z.string().min(1).max(50).regex(/^[a-z0-9-]+$/),
  lesson_id: z.number().int().positive(),
  watched: z.boolean(),
});

app.post('/progress', requireAuth(), zValidator('json', progressSchema), async (c) => {
  const requestId = crypto.randomUUID().slice(0, 8);
  const { course_id, lesson_id, watched } = c.req.valid('json');
  const user = c.get('user');

  try {
    // Verificar inscripción
    const enrollment = await c.env.DB.prepare(
      `SELECT access_type FROM enrollments WHERE user_id = ? AND course_id = ?`
    ).bind(user.user_id, course_id).first<{ access_type: string }>();

    if (!enrollment) {
      return c.json({ ok: false, codigo: 'NO_INSCRITO', mensaje: 'Aún no estás inscrito en este curso.', request_id: requestId }, 403);
    }

    // Verificar que la lección existe y está disponible
    const lesson = await c.env.DB.prepare(
      `SELECT id, is_free FROM lessons WHERE id = ? AND course_id = ?`
    ).bind(lesson_id, course_id).first<{ id: number; is_free: number }>();

    if (!lesson) {
      return c.json({ ok: false, codigo: 'CLASE_NO_EXISTE', mensaje: 'La clase no existe en este curso.', request_id: requestId }, 404);
    }

    const isFull = enrollment.access_type === 'FULL';
    if (lesson.is_free === 0 && !isFull) {
      return c.json({ ok: false, codigo: 'REQUIERE_ACTIVACION', mensaje: 'Esta clase es parte del curso completo.', request_id: requestId }, 403);
    }

    // Upsert progreso
    if (watched) {
      await c.env.DB.prepare(
        `INSERT INTO progress (user_id, course_id, lesson_id, watched_at)
         VALUES (?, ?, ?, datetime('now'))
         ON CONFLICT(user_id, lesson_id) DO UPDATE SET watched_at = datetime('now')`
      ).bind(user.user_id, course_id, lesson_id).run();
    } else {
      await c.env.DB.prepare(
        `DELETE FROM progress WHERE user_id = ? AND lesson_id = ?`
      ).bind(user.user_id, lesson_id).run();
    }

    // Devolver lista actualizada de lecciones vistas
    const watchedLessons = await c.env.DB.prepare(
      `SELECT lesson_id FROM progress WHERE user_id = ? AND course_id = ?`
    ).bind(user.user_id, course_id).all<{ lesson_id: number }>();

    return c.json({
      ok: true,
      watched_lesson_ids: watchedLessons.results.map((w: { lesson_id: number }) => w.lesson_id).sort((a, b) => a - b),
      request_id: requestId,
    });

  } catch (e) {
    console.error(`[${requestId}] Error en POST /progress:`, e);
    return c.json({ ok: false, codigo: 'ERROR_SERVIDOR', mensaje: 'No se pudo actualizar el progreso.', request_id: requestId }, 500);
  }
});

export default app;
</file>

<file path="mastercelular-api/src/routes/public.ts">
// mastercelular-api/src/routes/public.ts
// GET /api/courses/:courseId/public — Temario público (sin auth)
import { Hono } from 'hono';
import { zValidator } from '@hono/zod-validator';
import { z } from 'zod';

import type { Env } from '../types';

const app = new Hono<{ Bindings: Env }>();

// Schema de validación para courseId (slug)
const courseIdSchema = z.string().min(1).max(50).regex(/^[a-z0-9-]+$/);

// GET /api/courses/:courseId/public
app.get('/courses/:courseId/public', zValidator('param', z.object({ courseId: courseIdSchema })), async (c) => {
  const requestId = crypto.randomUUID().slice(0, 8);
  const courseId = c.req.param('courseId');

  try {
    // Obtener curso activo
    const course = await c.env.DB.prepare(
      `SELECT id, name, code_prefix, price_cents, currency, seller_name, seller_whatsapp, ga_measurement_id
       FROM courses WHERE id = ? AND is_active = 1`
    ).bind(courseId).first<{
      id: string;
      name: string;
      code_prefix: string;
      price_cents: number;
      currency: string;
      seller_name: string;
      seller_whatsapp: string;
      ga_measurement_id: string | null;
    }>();

    if (!course) {
      return c.json({
        ok: false,
        codigo: 'CURSO_NO_DISPONIBLE',
        mensaje: 'Este curso no está disponible.',
        request_id: requestId,
      }, 404);
    }

    // Obtener lecciones del curso (ordenadas por módulo y sort_order)
    const lessons = await c.env.DB.prepare(
      `SELECT id, module, title, sort_order, drive_url, is_free, duration_seconds
       FROM lessons WHERE course_id = ? ORDER BY module, sort_order`
    ).bind(courseId).all<{
      id: number;
      module: string;
      title: string;
      sort_order: number;
      drive_url: string;
      is_free: number;
      duration_seconds: number | null;
    }>();

    // Obtener materiales del curso (ordenados por sort_order)
    const materials = await c.env.DB.prepare(
      `SELECT id, title, sort_order, drive_url, file_type, file_size_bytes
       FROM materials WHERE course_id = ? ORDER BY sort_order`
    ).bind(courseId).all<{
      id: number;
      title: string;
      sort_order: number;
      drive_url: string;
      file_type: string;
      file_size_bytes: number | null;
    }>();

    // Formatear respuesta según CONTRATO-API.md (acción publico)
    const formattedLessons = lessons.results.map((lesson: {
      id: number;
      module: string;
      title: string;
      sort_order: number;
      drive_url: string;
      is_free: number;
      duration_seconds: number | null;
    }) => ({
      lesson_id: lesson.id,
      module: lesson.module,
      title: lesson.title,
      sort_order: lesson.sort_order,
      is_free: lesson.is_free === 1,
      available: lesson.is_free === 1, // Público solo ve gratis como disponibles
      url: lesson.is_free === 1 ? lesson.drive_url : null,
      duration_seconds: lesson.duration_seconds,
    }));

    const formattedMaterials = materials.results.map((material: {
      id: number;
      title: string;
      sort_order: number;
      drive_url: string;
      file_type: string;
      file_size_bytes: number | null;
    }) => ({
      material_id: material.id,
      title: material.title,
      sort_order: material.sort_order,
      // Público no ve URLs de materiales (solo títulos)
    }));

    return c.json({
      ok: true,
      course: {
        course_id: course.id,
        name: course.name,
        code_prefix: course.code_prefix,
        price_cents: course.price_cents,
        currency: course.currency,
        seller_name: course.seller_name,
        seller_whatsapp: course.seller_whatsapp,
        ga_measurement_id: course.ga_measurement_id,
      },
      lessons: formattedLessons,
      materials: formattedMaterials,
      request_id: requestId,
    });

  } catch (e) {
    console.error(`[${requestId}] Error en GET /courses/:courseId/public:`, e);
    return c.json({
      ok: false,
      codigo: 'ERROR_SERVIDOR',
      mensaje: 'No se pudo obtener el temario. Intenta de nuevo.',
      request_id: requestId,
    }, 500);
  }
});

export default app;
</file>

