.hero-acciones { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 1rem; }
.pildoras { display: flex; flex-wrap: wrap; gap: 0.5rem; }
.pildora { background: var(--color-fondo-alterno); border: 1px solid var(--color-borde); border-radius: 999px; padding: 0.3rem 0.8rem; font-size: 0.85rem; }
